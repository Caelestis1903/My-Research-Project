    "B": {
      "name": "TGA",
      "role": "fallback_and_control",
      "status": "NOT_IMPLEMENTED",
      "pair_budget_per_domain_task": 128,
      "alpha_candidates": [0.01, 0.03, 0.05],
      "lambda_aug_initial": 0.25,
      "projection": "disabled"
    }
  },
  "controls": [
    "clean-online",
    "clean-fixed-EMA",
    "Gaussian-D0-fixed-EMA",
    "matched-random-direction",
    "matched-isotropic-Gaussian"
  ],
  "phases": [
    {"id": 0, "name": "source_and_semantic_audit", "gate": "verified-forward-graph-and-clean-path-equivalence"},
