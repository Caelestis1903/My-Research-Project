  },
  "ema": {
    "initialization": "theta_0",
    "update_timing": "immediately_after_each_real_adam_step",
    "fast": "rho_fixed**2",
    "fixed": "rho_fixed",
    "slow": "sqrt(rho_fixed)",
    "pulse": "one_epoch_from_current_controller_state_then_discard",
    "adaptive_rho_change": "epoch_boundary_only"
  },
  "algorithms": {
    "A": {
      "states": 1,
      "controller": "argmax_smoothed_global_six_cell_train_macro_auc_gain",
      "tie_break": "fixed"
    },
    "B": {
      "states": 2,
      "controller": "argmax_smoothed_task_three_domain_train_macro_auc_gain",
      "routing": "task_id_selects_shared_S_history"
    },
    "C": {
      "states": 1,
      "readout": "F_S + lambda_task * (theta_S - F_S)",
      "lambda_candidates": "0 and 1-rho_fixed; optional 2*(1-rho_fixed) only after A1",
      "convex_only": true,
      "cannot_represent_slow_history": true
    }
  },
  "resource_limits": {
